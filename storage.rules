rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    match /inspections/{inspectionId}/{allPaths=**} {

      function isOwner() {
        return request.auth != null &&
               firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.userId == request.auth.uid;
      }

      // Apenas o dono da vistoria pode ler os arquivos
      allow read: if isOwner();

      // Apenas o dono pode gravar; valida tipo (imagem) e tamanho (máx 5MB)
      allow write: if isOwner()
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }
    
    // Nega tudo que não for na pasta inspections
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}